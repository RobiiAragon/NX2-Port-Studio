+// Real UDP discovery/reply traffic through the production socket translator.
+// The adapter fixture is confined to 127/8. No LAN is scanned or broadcast sent.
+#include "../net_socket.h"
+#include <assert.h>
+#include <errno.h>
+#include <net/if.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdatomic.h>
