+    // fixture's /24 makes the worker send the unchanged scan via unicast.
+    dm_net_test_interface adapter={htonl(0x7f000002),htonl(0xffffff00),if_nametoindex("lo0"),IFF_UP|IFF_BROADCAST,1};
