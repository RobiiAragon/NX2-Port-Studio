+static int native_udp(address *a) {
+    int fd = socket(AF_INET, SOCK_DGRAM, 0); struct sockaddr_in in = {.sin_len = sizeof in, .sin_family = AF_INET, .sin_addr.s_addr = a->ip, .sin_port = a->port};
