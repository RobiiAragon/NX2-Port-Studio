+#undef HLE_FORCE_WAIT
+#define HLE_FORCE(name, why, ret, cname, ...) static ret cname(__VA_ARGS__)
+#define HLE_FORCE_WAIT HLE_FORCE
+#include "../hle_friends.c"
+#include <CommonCrypto/CommonHMAC.h>
+#include <assert.h>
+#include <dirent.h>
+#include <fcntl.h>
+#include <ftw.h>
