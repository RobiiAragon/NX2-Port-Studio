diff --git a/dm/host/net_discovery.h b/dm/host/net_discovery.h
new file mode 100644
index 0000000..294dbc3
--- /dev/null
+++ b/dm/host/net_discovery.h
@@ -0,0 +1,43 @@
+// A bounded IPv4 discovery sweep. Addresses are in network byte order.
+#pragma once
+#include <arpa/inet.h>
+#include <stdint.h>
+#include <string.h>
+#include <errno.h>
+
+enum { DM_DISCOVERY_BATCH = 32, DM_DISCOVERY_TICK_MS = 8, DM_DISCOVERY_MAX_HOSTS = 4094 };
+typedef struct {
+    uint32_t local, first, last, target, cursor;
+    unsigned count, automatic;
+} dm_net_discovery_plan;
+// Darwin can report a negative ARP entry as EHOSTDOWN. These are destination
+// failures, not permission/interface failures; skip that neighbor in a sweep.
+static inline int dm_net_discovery_unreachable(int error) {
+    return error==EHOSTUNREACH||error==ENETUNREACH||error==EHOSTDOWN;
+}
+
+// This takes a validated adapter snapshot, not a guessed address range. /31,
+// /32, noncontiguous masks and networks broader than /20 are not discoverable.
+static inline int dm_net_discovery_subnet(dm_net_discovery_plan *p, uint32_t address, uint32_t mask) {
+    memset(p, 0, sizeof *p);
+    uint32_t a = ntohl(address), m = ntohl(mask), hosts = ~m;
+    if (!m || (hosts & (hosts + 1)) || hosts < 3 || hosts > DM_DISCOVERY_MAX_HOSTS + 1u ||
+        !a || a >= 0xe0000000u || !(a & hosts) || (a & hosts) == hosts) return -1;
+    p->local = a; p->first = (a & m) + 1; p->last = (a | hosts) - 1;
+    p->cursor = p->first; p->count = hosts - 2; p->automatic = 1;
+    return 0;
+}
+static inline int dm_net_discovery_next(dm_net_discovery_plan *p, uint32_t *address) {
+    if (!p->automatic) {
+        if (p->cursor++) return 0;
+        *address = p->target; return 1;
+    }
+    while (p->cursor <= p->last) {
+        uint32_t a = p->cursor++;
+        if (a != p->local) { *address = htonl(a); return 1; }
+    }
+    return 0;
+}
+static inline unsigned dm_net_discovery_duration(const dm_net_discovery_plan *p) {
+    return p->automatic ? ((p->count + DM_DISCOVERY_BATCH - 1) / DM_DISCOVERY_BATCH) * DM_DISCOVERY_TICK_MS : 0;
+}
diff --git a/dm/host/net_discovery_queue.inc b/dm/host/net_discovery_queue.inc
new file mode 100644
index 0000000..f01e51b
--- /dev/null
+++ b/dm/host/net_discovery_queue.inc
@@ -0,0 +1,128 @@
+// Discovery-only UDP fanout. A duplicate retains the original kernel socket,
+// source port and socket options. Slot generations cancel work on close/reuse.
+// Queuing a datagram has UDP's usual best-effort delivery semantics; it is not
+// an acknowledgement from a console. No ordinary unicast enters this queue.
+enum { NET_DISCOVERY_JOBS = 16, NET_DISCOVERY_PER_SOCKET = 2, NET_DISCOVERY_BYTES = 32768 };
+typedef struct {
+    net_ref socket; dm_net_discovery_plan plan; struct sockaddr_in destination;
+    size_t size; int flags; uint64_t expires; unsigned char bytes[];
+} net_discovery_job;
+static pthread_mutex_t g_discovery_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t g_discovery_changed = PTHREAD_COND_INITIALIZER;
+static net_discovery_job *g_discovery_jobs[NET_DISCOVERY_JOBS];
+static int g_discovery_started;
+#ifdef DM_NET_TEST
+static _Atomic(dm_net_test_discovery_sender) g_discovery_sender;
+void dm_net_test_set_discovery_sender(dm_net_test_discovery_sender sender) { atomic_store(&g_discovery_sender,sender); }
+#endif
+static long net_discovery_packet(int fd,const void *bytes,size_t size,int flags,const struct sockaddr_in *destination) {
+#ifdef DM_NET_TEST
+    dm_net_test_discovery_sender sender=atomic_load(&g_discovery_sender);
+    if(sender)return sender(fd,bytes,size,flags,destination->sin_addr.s_addr,destination->sin_port);
+#endif
+    return sendto(fd,bytes,size,flags,(const struct sockaddr *)destination,sizeof *destination);
+}
+long dm_net_discovery_send_native(int fd,const void *bytes,size_t size,int flags,uint32_t address,uint16_t port) {
+    struct sockaddr_in destination={.sin_len=sizeof destination,.sin_family=AF_INET,.sin_port=port,.sin_addr={address}};
+    return net_discovery_packet(fd,bytes,size,flags,&destination);
+}
+static void net_discovery_drop(unsigned i) {
+    net_discovery_job *job = g_discovery_jobs[i];
+    if (job) { close(job->socket.fd); free(job); g_discovery_jobs[i] = NULL; }
+}
+static void net_discovery_cancel(int guest, uint64_t generation) {
+    pthread_mutex_lock(&g_discovery_lock);
+    for (unsigned i = 0; i < NET_DISCOVERY_JOBS; ++i)
+        if (g_discovery_jobs[i] && g_discovery_jobs[i]->socket.guest == guest &&
+            g_discovery_jobs[i]->socket.generation == generation) net_discovery_drop(i);
+    pthread_cond_signal(&g_discovery_changed); pthread_mutex_unlock(&g_discovery_lock);
+}
+static void *net_discovery_worker(void *unused) {
+    (void)unused; unsigned cursor = 0; uint64_t next = 0;
+    pthread_mutex_lock(&g_discovery_lock);
+    for (;;) {
+        unsigned i, n;
+        for (n = 0; n < NET_DISCOVERY_JOBS; ++n) {
+            i = (cursor + n) % NET_DISCOVERY_JOBS;
+            net_discovery_job *job = g_discovery_jobs[i];
+            if (job && (!dm_net_enabled() || !net_live(&job->socket) || net_ms() >= job->expires)) net_discovery_drop(i);
+            if (g_discovery_jobs[i]) break;
+        }
+        if (n == NET_DISCOVERY_JOBS) { pthread_cond_wait(&g_discovery_changed, &g_discovery_lock); continue; }
+        uint64_t now = net_ms();
+        if (now < next) {
+            struct timespec deadline; clock_gettime(CLOCK_REALTIME, &deadline);
+            deadline.tv_nsec += (long)(next - now) * 1000000L;
+            deadline.tv_sec += deadline.tv_nsec / 1000000000L; deadline.tv_nsec %= 1000000000L;
+            pthread_cond_timedwait(&g_discovery_changed, &g_discovery_lock, &deadline); continue;
+        }
+        net_discovery_job *job = g_discovery_jobs[i]; unsigned sent = 0, bytes = 0;
+        for (; sent < DM_DISCOVERY_BATCH; ++sent) {
+            if (sent && bytes + job->size > NET_DISCOVERY_BYTES) break;
+            dm_net_discovery_plan saved = job->plan; uint32_t address;
+            if (!dm_net_discovery_next(&job->plan, &address)) { net_discovery_drop(i); break; }
+            job->destination.sin_addr.s_addr = address;
+            ssize_t result = net_discovery_packet(job->socket.fd, job->bytes, job->size, job->flags,&job->destination);
+            if (result < 0 && (errno == EAGAIN || errno == ENOBUFS || errno == EINTR)) { job->plan = saved; break; }
+            if(result<0&&!dm_net_discovery_unreachable(errno)) { net_discovery_drop(i);break; }
+            // An unreachable neighbor does not prevent discovery of others.
+            bytes += (unsigned)job->size;
+        }
+        cursor = (i + 1) % NET_DISCOVERY_JOBS; next = net_ms() + DM_DISCOVERY_TICK_MS;
+    }
+    return NULL;
+}
+static long net_discovery_enqueue(const net_ref *socket, dm_net_discovery_plan plan,
+                                  struct sockaddr_in destination, const void *bytes, size_t size, int flags) {
+    if (size > 65507) return net_error(90);
+    net_discovery_job *job = malloc(sizeof *job + size);
+    if (!job) return net_error(12);
+    *job = (net_discovery_job){.socket = *socket, .plan = plan, .destination = destination,
+                               .size = size, .flags = flags, .expires = net_ms() + 30000};
+    if (size) memcpy(job->bytes, bytes, size);
+    pthread_mutex_lock(&g_discovery_lock); unsigned free_slot = NET_DISCOVERY_JOBS, same = 0;
+    for (unsigned i = 0; i < NET_DISCOVERY_JOBS; ++i) {
+        net_discovery_job *old = g_discovery_jobs[i];
+        if (!old) { free_slot = i; continue; }
+        if (old->socket.guest != socket->guest || old->socket.generation != socket->generation) continue;
+        ++same;
+        if (old->size == size && old->flags == flags && old->destination.sin_port == destination.sin_port &&
+            old->plan.first == plan.first && old->plan.last == plan.last && old->plan.local == plan.local &&
+            (!size || !memcmp(old->bytes, bytes, size))) {
+            // Repeated identical queries during one sweep do not multiply it.
+            pthread_mutex_unlock(&g_discovery_lock); free(job); return (long)size;
+        }
+    }
+    if (free_slot == NET_DISCOVERY_JOBS || same >= NET_DISCOVERY_PER_SOCKET) {
+        pthread_mutex_unlock(&g_discovery_lock); free(job); return net_error(105);
+    }
+    if (!g_discovery_started) {
+        pthread_t thread; int error = pthread_create(&thread, NULL, net_discovery_worker, NULL);
+        if (error) { pthread_mutex_unlock(&g_discovery_lock); free(job); return net_error(net_errno(error)); }
+        pthread_detach(thread); g_discovery_started = 1;
+    }
+    job->socket.fd = fcntl(socket->fd, F_DUPFD_CLOEXEC, 0);
+    if (job->socket.fd < 0) { int error = errno; pthread_mutex_unlock(&g_discovery_lock); free(job); return net_error(net_errno(error)); }
+    ssize_t result=(ssize_t)size;
+    for(unsigned attempt=0;attempt<DM_DISCOVERY_BATCH;++attempt) {
+        uint32_t first;
+        if(!dm_net_discovery_next(&job->plan,&first)) {
+            int error=errno;close(job->socket.fd);pthread_mutex_unlock(&g_discovery_lock);free(job);return net_error(net_errno(error));
+        }
+        job->destination.sin_addr.s_addr=first;
+        result=net_discovery_packet(job->socket.fd,bytes,size,flags,&job->destination);
+        if(result>=0)break;
+        int error=errno;
+        if(dm_net_discovery_unreachable(error)) { result=(ssize_t)size;continue; }
+        close(job->socket.fd);pthread_mutex_unlock(&g_discovery_lock);free(job);return net_error(net_errno(error));
+    }
+    g_discovery_jobs[free_slot] = job; pthread_cond_signal(&g_discovery_changed);
+    pthread_mutex_unlock(&g_discovery_lock); return result;
+}
+#ifdef DM_NET_TEST
+unsigned dm_net_test_discovery_pending(void) {
+    unsigned count = 0; pthread_mutex_lock(&g_discovery_lock);
+    for (unsigned i = 0; i < NET_DISCOVERY_JOBS; ++i) count += g_discovery_jobs[i] != NULL;
+    pthread_mutex_unlock(&g_discovery_lock); return count;
+}
+#endif
diff --git a/dm/host/net_eventfd.inc b/dm/host/net_eventfd.inc
new file mode 100644
index 0000000..ee6597c
--- /dev/null
+++ b/dm/host/net_eventfd.inc
@@ -0,0 +1,135 @@
+// Local Horizon event counters. The counter, descriptor ownership and readiness
+// transitions share g_net_lock. Native pipes carry level notifications only:
+// nobody reads a count from a pipe, so semaphore/overflow semantics stay uint64.
+// Semantics: eventfd(2); Horizon flag encodings differ from Linux's constants.
+#define NET_EVENT_MAX (UINT64_MAX - 1)
+struct net_event {
+    uint64_t value;
+    unsigned refs;
+    int semaphore, nonblock, closed;
+    int notify[2][2], signaled[2]; // readable and writable, each a nonblocking pipe
+    pthread_cond_t changed;
+};
+static void net_event_level(net_event *e, int side, int on) {
+    if (e->signaled[side] == on) return;
+    char byte = 1; ssize_t result;
+    do {
+        // Every pipe end passed F_SETFL(O_NONBLOCK) before publication. This
+        // one-byte notification transition never performs a blocking read.
+        result = on ? write(e->notify[side][1], &byte, 1) : read(e->notify[side][0], &byte, 1); // NOLINT(clang-analyzer-unix.BlockInCriticalSection)
+    } while (result < 0 && errno == EINTR);
+    // A single byte is toggled under the lock; readers/pollers never consume it.
+    if (result == 1) e->signaled[side] = on;
+}
+static void net_event_changed(net_event *e) {
+    net_event_level(e, 0, e->closed || e->value != 0);
+    net_event_level(e, 1, e->closed || e->value < NET_EVENT_MAX);
+    pthread_cond_broadcast(&e->changed);
+}
+static void net_event_release_locked(net_event *e) {
+    if (--e->refs) return;
+    for (int k = 0; k < 2; k++) for (int j = 0; j < 2; j++) close(e->notify[k][j]);
+    pthread_cond_destroy(&e->changed); free(e);
+}
+static net_event *net_event_acquire(int guest) {
+    pthread_mutex_lock(&g_net_lock);
+    net_event *e = guest >= 0 && guest < NET_MAX && g_sockets[guest].used ? g_sockets[guest].event : NULL;
+    if (e) e->refs++;
+    pthread_mutex_unlock(&g_net_lock); return e;
+}
+int dm_net_eventfd(uint64_t value, int flags) {
+    // SDK20 passes flags 6 unchanged to IPC31; public ABI definitions identify
+    // semaphore=1 and nonblocking=4. Bit 2 is accepted without attributing an
+    // unverified guest effect. Host notification FDs are always CLOEXEC.
+    if (value == UINT64_MAX || ((unsigned)flags & ~7u)) return net_error(22);
+    net_event *e = calloc(1, sizeof *e); if (!e) return net_error(12);
+    for (int k = 0; k < 2; k++) for (int j = 0; j < 2; j++) e->notify[k][j] = -1;
+    int error = pthread_cond_init(&e->changed, NULL);
+    if (error) { free(e); return net_error(net_errno(error)); }
+    for (int k = 0; k < 2; k++) {
+        if (pipe(e->notify[k])) { error = errno; goto fail; }
+        for (int j = 0; j < 2; j++) if (fcntl(e->notify[k][j], F_SETFL, O_NONBLOCK) < 0 || fcntl(e->notify[k][j], F_SETFD, FD_CLOEXEC) < 0) { error = errno; goto fail; }
+    }
+    e->value = value; e->semaphore = !!(flags & 1); e->nonblock = !!(flags & 4); e->refs = 1;
+    pthread_mutex_lock(&g_net_lock);
+    int fd; for (fd = 0; fd < NET_MAX && g_sockets[fd].used; fd++) {}
+    if (fd < NET_MAX) {
+        uint64_t generation = g_sockets[fd].generation + 1;
+        g_sockets[fd] = (net_slot){-1, 1, 0, 0, generation, -1, -1, e};
+        net_event_changed(e);
+    }
+    pthread_mutex_unlock(&g_net_lock);
+    if (fd < NET_MAX) return fd;
+    error = EMFILE;
+fail:
+    for (int k = 0; k < 2; k++) for (int j = 0; j < 2; j++) if (e->notify[k][j] >= 0) close(e->notify[k][j]);
+    pthread_cond_destroy(&e->changed); free(e); return net_error(net_errno(error));
+}
+// Kernel copies reject unmapped/read-only/PROT_NONE guest spans instead of
+// faulting in the host. Preparing copyout first preserves graphics dirty tracking.
+static int net_guest_copyin(void *target, const void *source, size_t size) {
+    vm_size_t copied = 0;
+    return vm_read_overwrite(mach_task_self(), (vm_address_t)(uintptr_t)source, size,
+                             (vm_address_t)(uintptr_t)target, &copied) == KERN_SUCCESS && copied == size ? 0 : net_error(14);
+}
+static int net_guest_copyout(void *target, const void *source, size_t size) {
+    dm_guest_write_prepare(target, size);
+    return vm_write(mach_task_self(), (vm_address_t)(uintptr_t)target, (vm_offset_t)(uintptr_t)source,
+                    (mach_msg_type_number_t)size) == KERN_SUCCESS ? 0 : net_error(14);
+}
+// Entered/returned with g_net_lock held. Recheck after publishing the wait so a
+// write/close between unlocking and cond_wait cannot be lost. The bounded wait
+// also permits guest pause/resume; it never turns into a guest-visible timeout.
+static void net_event_wait(net_event *e, int writing, uint64_t value) {
+    pthread_mutex_unlock(&g_net_lock); dm_guest_host_wait_begin(); pthread_mutex_lock(&g_net_lock);
+    int blocked = writing ? value > NET_EVENT_MAX - e->value : !e->value;
+    if (!e->closed && !e->nonblock && blocked) {
+        struct timespec deadline = {0, NET_SLICE_MS * 1000000};
+        pthread_cond_timedwait_relative_np(&e->changed, &g_net_lock, &deadline);
+    }
+    pthread_mutex_unlock(&g_net_lock); dm_guest_host_wait_end(); pthread_mutex_lock(&g_net_lock);
+}
+static long net_event_read(net_event *e, void *buffer, unsigned long size) {
+    pthread_mutex_lock(&g_net_lock); long result;
+    if (size < sizeof(uint64_t)) { result = net_error(22); goto done; }
+    for (;;) {
+        if (e->closed) { result = net_error(9); break; }
+        if (e->value) {
+            uint64_t value = e->semaphore ? 1 : e->value;
+            if (net_guest_copyout(buffer, &value, sizeof value)) { result = -1; break; }
+            e->value -= value; net_event_changed(e); result = sizeof value; break;
+        }
+        if (e->nonblock) { result = net_error(11); break; }
+        net_event_wait(e, 0, 0);
+    }
+done:
+    net_event_release_locked(e); pthread_mutex_unlock(&g_net_lock); return result;
+}
+static long net_event_write(net_event *e, const void *buffer, unsigned long size) {
+    uint64_t value = 0; long result;
+    // Copy once before any wait: an interrupted writer never rereads mutable
+    // caller memory, and EFAULT/invalid increments leave the counter untouched.
+    int error = size < sizeof value ? net_error(22) : net_guest_copyin(&value, buffer, sizeof value);
+    pthread_mutex_lock(&g_net_lock);
+    if (error) { result = -1; goto done; }
+    if (value == UINT64_MAX) { result = net_error(22); goto done; }
+    for (;;) {
+        if (e->closed) { result = net_error(9); break; }
+        if (value <= NET_EVENT_MAX - e->value) { e->value += value; net_event_changed(e); result = sizeof value; break; }
+        if (e->nonblock) { result = net_error(11); break; }
+        net_event_wait(e, 1, value);
+    }
+done:
+    net_event_release_locked(e); pthread_mutex_unlock(&g_net_lock); return result;
+}
+long dm_net_read(int fd, void *buffer, unsigned long size) {
+    net_event *e = net_event_acquire(fd);
+    return e ? net_event_read(e, buffer, size) : dm_net_recv(fd, buffer, size, 0, NULL, NULL);
+}
+long dm_net_write(int fd, const void *buffer, unsigned long size) {
+    net_event *e = net_event_acquire(fd);
+    return e ? net_event_write(e, buffer, size) : dm_net_send(fd, buffer, size, 0, NULL, 0);
+}
+int dm_net_eventfd_read(int fd, uint64_t *value) { return dm_net_read(fd, value, sizeof *value) == sizeof *value ? 0 : -1; }
+int dm_net_eventfd_write(int fd, uint64_t value) { return dm_net_write(fd, &value, sizeof value) == sizeof value ? 0 : -1; }
+#undef NET_EVENT_MAX
diff --git a/dm/host/net_socket.h b/dm/host/net_socket.h
new file mode 100644
index 0000000..633503b
--- /dev/null
+++ b/dm/host/net_socket.h
@@ -0,0 +1,79 @@
+// Horizon socket ABI, translated by hle_net_backend.c. Opt-in Apple IPv4 TCP/UDP.
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include "net_discovery.h"
+
+typedef struct { int32_t fd; int16_t events, revents; } dm_net_pollfd;
+typedef struct { int32_t flags, family, type, protocol; uint32_t addrlen, pad; void *addr; char *canonname; void *next; } dm_net_addrinfo;
+typedef struct { int32_t flags, family, type, protocol; uint32_t addrlen, pad; char *canonname; void *addr; void *next; } dm_net_addrinfo_legacy;
+typedef enum { DM_NET_OFFLINE, DM_NET_LAN, DM_NET_LDN, DM_NET_AUTO } dm_net_mode_t;
+dm_net_mode_t dm_net_mode(void);
+// Automatic enables independent service capabilities, not a mutable global
+// session type. The guest chooses sockets, LDN or online APIs from its menu.
+static inline int dm_net_ldn_enabled(void) {
+    dm_net_mode_t mode = dm_net_mode();
+    return mode == DM_NET_LDN || mode == DM_NET_AUTO;
+}
+int dm_net_enabled(void);
+// Internal host API: caller owns the CLOEXEC, non-blocking duplicate. Closing or
+// reusing the guest descriptor cannot attach the duplicate to another connection.
+int dm_net_dup_native(int guest);
+int dm_net_dup_native_generation(int guest, uint64_t *generation);
+int dm_net_close_generation(int guest, uint64_t generation);
+// Discovery uses native broadcast when permitted, an optional explicit peer, or
+// a bounded unicast sweep of the actual adapter. Ordinary unicast is unchanged.
+int dm_net_discovery_prepare(uint32_t destination, dm_net_discovery_plan *plan);
+// For verified discovery queries only: 1 supplies a best-effort complementary
+// unicast plan, 0 keeps native behavior. Does not alter the real capability,
+// explicit peer choice, or the guest's last errno on native success.
+int dm_net_discovery_supplement(uint32_t destination,dm_net_discovery_plan *plan);
+// Internal native UDP sender shared by both discovery transports. Addresses
+// and ports use network order. This does not apply a discovery policy itself.
+long dm_net_discovery_send_native(int fd,const void *bytes,size_t size,int flags,
+                                  uint32_t address,uint16_t port);
+int dm_net_discovery_target(uint32_t broadcast, uint32_t *target);
+void dm_net_set_multicast_allowed(int allowed);
+int dm_net_multicast_allowed(void);
+#ifdef DM_NET_TEST
+// Test-only adapter snapshots let real loopback datagrams exercise the complete
+// production send path without probing the user's LAN or enabling broadcast.
+typedef struct { uint32_t address, mask; unsigned index, flags; int local_link; } dm_net_test_interface;
+void dm_net_test_set_interface(const dm_net_test_interface *interface);
+unsigned dm_net_test_discovery_pending(void);
+typedef long (*dm_net_test_discovery_sender)(int fd,const void *bytes,size_t size,int flags,
+                                             uint32_t address,uint16_t port);
+void dm_net_test_set_discovery_sender(dm_net_test_discovery_sender sender);
+#endif
+int dm_net_errno(void);
+void dm_net_set_errno(int e);
+int dm_net_socket(int family, int type, int protocol);
+// Local counter descriptors remain available offline; typed helpers return 0 on
+// success while generic Read/Write return the eight-byte transfer size.
+int dm_net_eventfd(uint64_t value, int flags);
+int dm_net_eventfd_read(int fd, uint64_t *value);
+int dm_net_eventfd_write(int fd, uint64_t value);
+long dm_net_read(int fd, void *buffer, unsigned long size);
+long dm_net_write(int fd, const void *buffer, unsigned long size);
+int dm_net_close(int fd);
+void dm_net_finalize(void);
+int dm_net_bind(int fd, const void *addr, unsigned len);
+int dm_net_connect(int fd, const void *addr, unsigned len);
+int dm_net_listen(int fd, int backlog);
+int dm_net_accept(int fd, void *addr, unsigned *len);
+int dm_net_name(int fd, void *addr, unsigned *len, int peer);
+int dm_net_shutdown(int fd, int how);
+int dm_net_fcntl(int fd, int cmd, int flags);
+int dm_net_sockopt(int fd, int level, int option, void *value, unsigned *len, int set);
+long dm_net_recv(int fd, void *buf, unsigned long len, int flags, void *addr, unsigned *addrlen);
+long dm_net_send(int fd, const void *buf, unsigned long len, int flags, const void *addr, unsigned addrlen);
+int dm_net_poll(void *fds, uint64_t count, int timeout_ms);
+int dm_net_idle(void);
+int dm_net_select(int nfds, void *read, void *write, void *except, const int64_t *timeout);
+int dm_net_getaddrinfo(const char *host, const char *service, const void *hints, void **result);
+int dm_net_getaddrinfo_legacy(const char *host, const char *service, const void *hints, void **result);
+void dm_net_freeaddrinfo(void *result);
+void *dm_net_gethostbyname(const char *name);
+int dm_net_ipconfig(uint32_t *address, uint32_t *mask, uint32_t *gateway, uint32_t *dns1, uint32_t *dns2);
+int dm_nifm_available(void);
+void dm_nifm_submit_wait(void);
