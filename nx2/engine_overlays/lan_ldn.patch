+    bl _thr_svc_leave
+    str x20, [sp, #0]
+    b Ldm_hle_wait_restore
+
+Ldm_hle_wait_restore:
+    ldr x9, [sp, #784]
+    msr fpcr, x9
+    ldr x9, [sp, #776]
+    msr fpsr, x9
+    ldr x9, [sp, #768]
+    msr nzcv, x9
+    ldp q0, q1, [sp, #256]
+    ldp q2, q3, [sp, #288]
